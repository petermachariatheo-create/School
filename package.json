{
  "name": "school",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first modular school management system",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build -w @school/shared && npm run build -w @school/server && npm run build -w @school/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test --experimental-test-module-mocks \"packages/*/test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/*/test/**/*.test.ts\"",
    "contract:check": "node scripts/check-contracts.ts",
    "perf": "node scripts/perf.ts",
    "build:windows": "node scripts/build-windows.ts",
    "check:package": "node scripts/check-package.ts",
    "package": "npm run build:windows && npm run check:package",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run contract:check && npm run build",
    "dev:server": "npm run dev -w @school/server",
    "dev:web": "npm run dev -w @school/web",
    "seed": "npm run seed -w @school/server"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
